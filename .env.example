# ==============================================================================
# MOSIAC ATELIER: ENVIRONMENT CONFIGURATION (.env.example)
# Production-Grade Tracking, Attribution, CRM & Conversions Infrastructure
# ==============================================================================

# Core Applet Host URL (injected automatically in AI Studio / Cloud Run)
APP_URL="https://mosiac.rw"

# ------------------------------------------------------------------------------
# 1. META PIXEL & CONVERSIONS API (CAPI)
# ------------------------------------------------------------------------------
# Meta Pixel ID (Browser Tracking Base Code & Server CAPI target)
META_PIXEL_ID="147852369012345"
VITE_META_PIXEL_ID="147852369012345"

# Meta Graph API Access Token (System User Permanent Token with ads_management / events permissions)
# CRITICAL: Read exclusively on server-side. Never expose client-side.
META_CAPI_TOKEN="EAABxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
META_CONVERSIONS_API_ACCESS_TOKEN="EAABxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Meta Test Event Code (Optional: Found in Events Manager > Test Events > 'TESTxxxxx')
# Used for real-time verification before going to production
META_TEST_EVENT_CODE=""

# ------------------------------------------------------------------------------
# 2. CRM INTEGRATION & PIPELINE ATTRIBUTION
# ------------------------------------------------------------------------------
# Outbound CRM Webhook (GoHighLevel, HubSpot, Zapier, Make, or custom CRM)
# Receives full contact payloads with first-touch and last-touch attribution
CRM_WEBHOOK_URL="https://services.leadconnectorhq.com/hooks/xxxxxxxxxxxx"

# CRM API Key / Bearer Token for outbound authentication
CRM_API_KEY=""

# Inbound CRM Webhook Secret (/api/crm-stage listener)
# Verifies incoming pipeline stage webhooks from your CRM (Qualified -> Booked -> Won)
CRM_WEBHOOK_SECRET="crm_sec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 3. GOOGLE ANALYTICS 4 & GOOGLE ADS ROAS
# ------------------------------------------------------------------------------
# GA4 Measurement ID (e.g., G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=""

# Google Ads Conversion ID (e.g., AW-XXXXXXXXXX)
VITE_GOOGLE_ADS_ID=""

# Google Ads Conversion Labels for automated Smart Bidding / tROAS
VITE_GOOGLE_ADS_PURCHASE_LABEL=""
VITE_GOOGLE_ADS_LEAD_LABEL=""

# ------------------------------------------------------------------------------
# 4. DATABASE & STORAGE (SUPABASE)
# ------------------------------------------------------------------------------
SUPABASE_PROJECT_ID="your-supabase-project-id"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (ESICIA K-PAY & RWANDAN MOBILE MONEY)
# ------------------------------------------------------------------------------
ESICIA_MERCHANT_ID="your-esicia-merchant-id"
ESICIA_API_KEY="your-esicia-api-key"
ESICIA_SECRET_KEY="your-esicia-secret-key"
ESICIA_API_URL="https://pay.esicia.com/api"
ESICIA_ENVIRONMENT="sandbox"
ESICIA_CALLBACK_URL="https://mosiac.rw/api/payment/esicia/callback"

# ------------------------------------------------------------------------------
# 6. STUDIO ADMIN CREDENTIALS
# ------------------------------------------------------------------------------
ADMIN_ACCESS_CODE="atelier-kigali-2024"
